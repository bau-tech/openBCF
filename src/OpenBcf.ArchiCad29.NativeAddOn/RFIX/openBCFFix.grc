/* *****************************************************************************
// Non-localizable resource description for the openBCF Add-On
//
// Modeled directly on the real ArchiCAD 29 API DevKit's own example .grc files
// (Examples/Selection_Manager/RFIX/*.grc and Examples/Browser_Control/RFIX/*.grc in
// https://github.com/GRAPHISOFT/archicad-api-devkit) - 'MDID'/'STR#'/'GDLG'/'DLGH' resource
// shapes below are copied from those, not guessed.
// ****************************************************************************/


/* 'MDID' - Add-On developer/local identifier pair. 960840751 is a real GRAPHISOFT Developer ID,
   registered at https://archicadapi.graphisoft.com (approved 2026-08-12). An earlier placeholder
   (0/1), and then a guessed-but-still-invalid local ID (960840751/1), both made ArchiCAD reject
   the Add-On outright at load time with "This add-on cannot be validated. Please contact the
   distributor." - the local ID isn't developer-assigned the way that second attempt assumed; per
   the DevKit's own docs (docs/_tools__add_on_management.html), it must be generated by GRAPHISOFT
   from the developer ID plus an authorization key, done by registering the Add-On at the developer
   portal. 4025893662 is the real local ID the portal generated for "openBCF" under this Developer
   ID (portal entry created 2026-08-12). */
'MDID' 32500 "Add-On Identifier" {
	960840751	/* GRAPHISOFT Developer ID */
	4025893662	/* Local Add-On ID, generated by archicadapi.graphisoft.com for "openBCF" */
}


'STR#' 32000 "Add-on Name and Description" {
/* [  1] */		"openBCF"
/* [  2] */		"Open BCF client for ArchiCAD"
}

/* Own top-level main menu, no submenu: per ACAPI_MenuItem_RegisterMenu's doc comment
   (Support/Inc/ACAPinc.h) with menuPosCode = MenuCode_UserDef, a *single* header string (item
   [0], with no [1] header before the indexed items) makes that string the title of a brand new
   top-level menu, with the indexed items placed directly in it - "openBCF > openBCF Panel", not
   "Window > openBCF > openBCF Panel". An earlier version of this file had "Window" as item [0]
   and "openBCF" as item [1] (the two-header "main menu + submenu" shape the same doc describes) -
   since "Window" matches one of ArchiCAD's own existing menu titles, that made "openBCF" a
   *submenu inserted into* Window instead of its own menu (the doc explicitly warns about this:
   "If this first item is the same as one of the server application's main menu titles ... your
   add-on's menu won't appear [as its own menu]"). Enabled-state suffix codes (^ES^EE^EI^E3^EL
   etc.) match the set Browser_Control's own palette-toggle menu item uses. */
'STR#' 32500 "Strings for the Menu" {
/* [   ] */		"openBCF"
/* [  1] */			"openBCF Panel^ES^EE^EI^ED^EW^E3^EL"
}

/* --- Floating openBCF palette -------------------------------------------------------------
   Layout: a single Browser item filling the whole client area - a real ACAPI/DGLib control
   (DG::Browser, Support/Modules/DGLib/DGBrowser.hpp) hosting the DUI3 frontend natively, in
   ArchiCAD's own process/thread (see BcfPalette.cpp's header comment - this replaced an earlier
   UserItem + foreign-process-HWND-reparenting design that deadlocked ArchiCAD live). Matches the
   real DevKit's own Browser_Control example (Examples/Browser_Control/RFIX/Browser_ControlFix.grc)
   and Speckle's actual ArchiCAD connector's SpecklePalette.grc exactly - `Browser <x> <y> <w> <h>`,
   no extra flags. */
'GDLG'  32500    Palette | topCaption | close | grow   0   0  480  720  "openBCF"  {
/* [  1] */ Browser			0   0  480  720
}

'DLGH'  32500  DLG_32500_openBCF_Palette {
1	"openBCF"		Browser_0
}
