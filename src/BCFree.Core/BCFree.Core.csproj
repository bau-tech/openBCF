<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 is required because Tekla Structures 2025 add-ins load in-process into Tekla's
         .NET Framework host; net8.0 covers the Revit 2025 client and standalone tooling. -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Polyfills/**/*.cs" Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
