<UserControl
    x:Class="BCFree.Dui.WebView.BcfDuiWebView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="White">
        <wv2:WebView2 x:Name="Browser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <TextBlock
            x:Name="StatusText"
            Visibility="Collapsed"
            Background="#FFF3F3"
            Foreground="#B42318"
            TextWrapping="Wrap"
            Padding="12"
            FontFamily="Consolas" />
    </Grid>
</UserControl>
